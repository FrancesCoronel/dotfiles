#!/usr/bin/env bash

DOT="$HOME/.dotfiles"
SSHCONFIG="$HOME/.ssh/config"

# Configure nano as default editor
git config --global core.editor nano

# Add SSH Config file
echo ""
echo "Adding config file for ssh-keys"
mkdir -p "$HOME/.ssh/"

if ! grep -q "^Host github.com" "$SSHCONFIG" 2> /dev/null; then
  cat >> "$SSHCONFIG" <<EOM
Host github.com
  Hostname github.com
  IdentityFile $HOME/.ssh/github_rsa
EOM
fi

echo "Please select which task you would like to perform"
echo ""
echo "[1] Configure Global Git Settings"
echo "[2] Generate Github SSH Key"
echo "[3] Copy over existing Git config"
echo "[4] All of the above"
echo "[Q/q] Quit"
echo ""

function setdefaultgitconfig () {
  echo "Copying over existing Git config"
  cp -RfXv "$DOT/git/.gitconfig" "$HOME/.gitconfig"
  echo "Okay all good"
}

function gitconfig () {
  read -r -p "Please enter your Git Author Name: " GIT_AUTHOR_NAME
  git config --global user.name "$GIT_AUTHOR_NAME"

  read -r -p "Please enter your Git Author Email: " GIT_AUTHOR_EMAIL
  git config --global user.email "$GIT_AUTHOR_EMAIL"

  git config --global push.default simple
  git config --global alias.lg "log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative"
}

function github_sshkey () {
  echo ""
  read -r -p "Please enter your github email: " GITHUB_EMAIL
  read -r -p "Please add a title to your key: " GITHUB_TITLE
  echo -n "Please enter a new Passphrase:  "
  read -r -s PASSPHRASE
  ssh-keygen -t rsa -C "$GITHUB_EMAIL" -f "$HOME/.ssh/github_rsa" -P "$PASSPHRASE"
  ssh-add "$HOME/.ssh/github_rsa" && pbcopy < "$HOME/.ssh/github_rsa.pub"

  # GitHub no longer accepts a password over its API, so sign in with the
  # GitHub CLI (installed by bootstrap.sh) and let it upload the key
  echo ""
  echo "Login to your github account"
  if gh auth status -h github.com > /dev/null 2>&1; then
    gh auth refresh -h github.com -s admin:public_key
  else
    gh auth login -h github.com -p ssh --skip-ssh-key -w -s admin:public_key
  fi

  echo ""
  echo "Saving SSH-Key to Github: "
  gh ssh-key add "$HOME/.ssh/github_rsa.pub" --title "$GITHUB_TITLE"
  echo "Done!"

  echo ""
  echo "Github SSH-Key Verification: "
  ssh -T git@github.com
}

function exec_all () {
  setdefaultgitconfig;
  sleep 5
  gitconfig;
  sleep 5
  github_sshkey;
  sleep 5
}

while true; do
  read -r -p "Select an answer and press return " ANSWER
  case $ANSWER in
    [1]*) gitconfig; break;;
    [2]*) github_sshkey; break;;
    [3]*) setdefaultgitconfig; break;;
    [4]*) exec_all; break;;
    [Q/q]*) exit;;
    *) echo "Please select from the options above"
  esac
done
