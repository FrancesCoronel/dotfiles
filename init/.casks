#!/usr/bin/env bash

# Homebrew asks to confirm every install that pulls in dependencies; skip that
export HOMEBREW_NO_ASK=1

# Yellow Color
YELLOW='\033[1;33m'
# No Color
NC='\033[0m'

# Install all casks
function cask() {
  if brew info "${@}" | grep "Not installed" > /dev/null; then
    brew install "${@}" --cask
  else
    echo "${YELLOW}$* is already installed.${NC}"
  fi
}

cask 1password
cask aerial
cask bartender
cask chatgpt
cask cleanmymac
cask discord
cask figma
cask github
cask google-chrome
cask google-drive
cask gpg-suite-no-mail
cask granola
cask imageoptim
cask imazing
cask linear
cask loom
cask notion
cask obsidian
cask qlmarkdown
cask raycast
cask readdle-spark
cask slack
cask spotify
cask suspicious-package
cask the-unarchiver
cask todoist-app
cask tower
cask visual-studio-code
cask vlc
cask warp
cask whatsapp
cask wispr-flow
cask zoom

echo ""
echo "Cleaning up installation files..."
brew cleanup
