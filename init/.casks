#!/usr/bin/env bash

# Homebrew asks to confirm every install that pulls in dependencies; skip that
export HOMEBREW_NO_ASK=1

# Yellow Color
YELLOW='\033[1;33m'
# No Color
NC='\033[0m'

# Install all casks
function cask() {
  if brew info "${@}" | grep "Not installed" > /dev/null; then
    brew install "${@}" --cask
  else
    echo "${YELLOW}$* is already installed.${NC}"
  fi
}

cask 1password
cask aerial
cask alfred
cask bartender
cask camo-studio
cask cardhop
cask chatgpt
cask cleanmymac
cask discord
cask fantastical
cask figma
cask flux-app
cask gifox
cask github
cask gitify
cask google-chrome
cask google-drive
cask gpg-suite-no-mail
cask grammarly-desktop
cask granola
cask image2icon
cask imageoptim
cask imazing
cask iterm2
cask kaleidoscope
cask keycastr
cask linear
cask loom
cask notion
cask obsidian
cask provisionql
cask qlmarkdown
cask raycast
cask readdle-spark
cask rocket
cask slack
cask spotify
cask suspicious-package
cask the-unarchiver
cask todoist-app
cask tower
cask visual-studio-code
cask vlc
cask warp
cask whatsapp
cask wispr-flow
cask zoom

echo ""
echo "Cleaning up installation files..."
brew cleanup
